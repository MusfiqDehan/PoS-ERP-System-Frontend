# Frontend environment template.
# Copy to .env.local for local development.

# ── Local development (recommended) ─────────────────────────────────────────
# Browser calls Django directly (CORS enabled in dev). Do NOT use relative /api/v1
# here — the Next.js dev proxy strips trailing slashes and breaks Django APPEND_SLASH.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8002/api/v1
NEXT_PUBLIC_PUBLIC_API_BASE_URL=http://localhost:8002/api/v1
NEXT_PUBLIC_PUBLIC_DOMAIN=localhost
BACKEND_PROXY_TARGET=http://host.docker.internal:8002
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8002
PORT=3002

# ── Production (Traefik routes /api/* to backend; same-origin relative URLs) ──
# NEXT_PUBLIC_API_BASE_URL=/api/v1
# NEXT_PUBLIC_PUBLIC_API_BASE_URL=https://shop.musfiqdehan.com/api/v1
# NEXT_PUBLIC_PUBLIC_DOMAIN=shop.musfiqdehan.com
# NEXT_PUBLIC_TENANT_BASE_DOMAIN=shop.musfiqdehan.com
# NEXT_PUBLIC_WS_BASE_URL=wss://shop.musfiqdehan.com
# NODE_ENV=production
