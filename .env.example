# Frontend environment template.
# Copy this file to .env.local for development or use the values as Docker build args for production.

# API base URL consumed by the frontend code.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Hostname for the public / platform domain.
NEXT_PUBLIC_PUBLIC_DOMAIN=localhost

# Next.js dev-server proxy target used by the local Docker setup.
BACKEND_PROXY_TARGET=http://host.docker.internal:8002

# WebSocket base URL.
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8002

# Dev server port (local Docker maps 3002:3002).
PORT=3002
