# Base URL of the Django (DRF) backend API.
# Local dev backend runs on port 8002 (see server/.env.example PORT=8002).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8002

# Base domain shown in the subdomain preview on /register
# (e.g. typing "jubayer" shows "jubayer.sortorium.com").
NEXT_PUBLIC_TENANT_BASE_DOMAIN=sortorium.com
