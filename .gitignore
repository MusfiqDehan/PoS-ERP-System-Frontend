# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Lockfiles from package managers other than npm (this repo uses package-lock.json)
bun.lock
bun.lockb
yarn.lock
pnpm-lock.yaml

# ---------------------------------------------------------------------------
# Next.js / build output
# ---------------------------------------------------------------------------
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Bundle analyzer
analyze/
.next/analyze/

# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------
coverage/
*.lcov
.vitest/
playwright-report/
test-results/
blob-report/
.nyc_output/

# ---------------------------------------------------------------------------
# Environment — commit .env.example only; never commit local/prod secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Logs & debug
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
.stylelintcache
*.pid
*.seed
*.pid.lock

# ---------------------------------------------------------------------------
# Editor / IDE
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.history/
*.sublime-project
*.sublime-workspace

# AI assistant / local tooling
.claude/
.cursor/
.mcps/
.agent/
.next-root-owned/

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Security / certs
# ---------------------------------------------------------------------------
*.pem
*.key
*.crt
*.p12

# ---------------------------------------------------------------------------
# Deployment / hosting
# ---------------------------------------------------------------------------
.vercel
.deploy-revision
.netlify/

# ---------------------------------------------------------------------------
# Generated / local-only
# ---------------------------------------------------------------------------
graphify-out/
graphify/

# Project notes kept outside the repo
docs/
BACKEND_BUG_NOTES/
NOTES/
*.notes.md
daily-task.md
TODO_*.md

# git recovery backups
.git.broken/
*.corrupt.bak

# misc temp / scratch
*.tmp
*.temp
*.bak
*.orig
*.rej
